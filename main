#include <iostream>
#include <string>
#include <vector>
#include <list>
#include <cstdint>
#include <iomanip>

using namespace std;

uint64_t demoHash(const string& s) {
    uint64_t h = 1469598103934665603ULL;
    for (unsigned char c : s) {
        h = (h ^ c) * 1099511628211ULL;
    }
    return h;
}

struct UserRecord {
    string username;
    string salt;
    uint64_t passwordHash;
};

enum CollisionStrategy {
    CHAINING,
    LINEAR_PROBING,
    QUADRATIC_PROBING,
    DOUBLE_HASHING
};

class HashTable {
private:
    enum EntryType { EMPTY, OCCUPIED, DELETED };

    struct TableEntry {
        UserRecord record;
        EntryType state = EMPTY;
    };

    vector<list<UserRecord>> chainTable;
    vector<TableEntry> openTable;

    size_t capacity;
    size_t elementCount;
    CollisionStrategy strategy;
    const string pepper = "StaticSecretPepper123!";

    size_t secondHash(uint64_t hashVal) const {
        size_t step = (hashVal % (capacity - 1)) + 1;
        return (step % 2 == 0) ? step + 1 : step;
    }

    void rehash() {
        cout << "\n[SYSTEM EVENT] Load factor threshhold exceeded (" << loadFactor()
             << "). Resizing table from " << capacity << " to " << capacity * 2 << "...\n";

        size_t oldCapacity = capacity;
        capacity *= 2;

        if (strategy == CHAINING) {
            vector<list<UserRecord>> oldChain = chainTable;
            chainTable.clear();
            chainTable.resize(capacity);
            elementCount = 0;

            for (const auto& chainList : oldChain) {
                for (const auto& record : chainList) {
                    insertRecord(record);
                }
            }
        } else {
            vector<TableEntry> oldOpen = openTable;
            openTable.clear();
            openTable.resize(capacity);
            elementCount = 0;

            for (const auto& entry : oldOpen) {
                if (entry.state == OCCUPIED) {
                    insertRecord(entry.record);
                }
            }
        }
        cout << "[SYSTEM EVENT] Rehash complete. New capacity: " << capacity
             << ", Load factor reset to: " << loadFactor() << "\n\n";
    }

    bool insertRecord(const UserRecord& rec) {
        if (loadFactor() >= 0.75) {
            rehash();
        }

        uint64_t hashVal = demoHash(rec.username);

        if (strategy == CHAINING) {
            size_t idx = hashVal % capacity;
            for (auto& item : chainTable[idx]) {
                if (item.username == rec.username) {
                    item = rec;
                    return true;
                }
            }
            chainTable[idx].push_back(rec);
            elementCount++;
            return true;
        }
        else {
            size_t firstDeletedIndex = capacity;
            for (size_t i = 0; i < capacity; ++i) {
                size_t idx = 0;
                if (strategy == LINEAR_PROBING) {
                    idx = (hashVal + i) % capacity;
                } else if (strategy == QUADRATIC_PROBING) {
                    idx = (hashVal + i * i) % capacity;
                } else if (strategy == DOUBLE_HASHING) {
                    idx = (hashVal + i * secondHash(hashVal)) % capacity;
                }

                if (openTable[idx].state == OCCUPIED) {
                    if (openTable[idx].record.username == rec.username) {
                        openTable[idx].record = rec;
                        return true;
                    }
                } else if (openTable[idx].state == DELETED) {
                    if (firstDeletedIndex == capacity) {
                        firstDeletedIndex = idx;
                    }
                } else if (openTable[idx].state == EMPTY) {
                    size_t targetIdx = (firstDeletedIndex != capacity) ? firstDeletedIndex : idx;
                    openTable[targetIdx].record = rec;
                    openTable[targetIdx].state = OCCUPIED;
                    elementCount++;
                    return true;
                }
            }
        }
        return false;
    }

public:
    HashTable(size_t initialCapacity = 4, CollisionStrategy strat = CHAINING)
        : capacity(initialCapacity), elementCount(0), strategy(strat) {
        if (strategy == CHAINING) {
            chainTable.resize(capacity);
        } else {
            openTable.resize(capacity);
        }
    }

    double loadFactor() const {
        return static_cast<double>(elementCount) / capacity;
    }

    uint64_t computePasswordHash(const string& salt, const string& rawPassword) const {
        return demoHash(salt + rawPassword + pepper);
    }

    bool insert(const string& username, const string& password) {
        string salt = "salt_" + username + "_rnd";
        uint64_t passHash = computePasswordHash(salt, password);
        UserRecord rec{username, salt, passHash};
        return insertRecord(rec);
    }

    UserRecord* find(const string& username) {
        uint64_t hashVal = demoHash(username);

        if (strategy == CHAINING) {
            size_t idx = hashVal % capacity;
            for (auto& rec : chainTable[idx]) {
                if (rec.username == username) {
                    return &rec;
                }
            }
        } else {
            for (size_t i = 0; i < capacity; ++i) {
                size_t idx = 0;
                if (strategy == LINEAR_PROBING) {
                    idx = (hashVal + i) % capacity;
                } else if (strategy == QUADRATIC_PROBING) {
                    idx = (hashVal + i * i) % capacity;
                } else if (strategy == DOUBLE_HASHING) {
                    idx = (hashVal + i * secondHash(hashVal)) % capacity;
                }

                if (openTable[idx].state == EMPTY) {
                    return nullptr;
                }
                if (openTable[idx].state == OCCUPIED && openTable[idx].record.username == username) {
                    return &openTable[idx].record;
                }
            }
        }
        return nullptr;
    }

    bool remove(const string& username) {
        uint64_t hashVal = demoHash(username);

        if (strategy == CHAINING) {
            size_t idx = hashVal % capacity;
            for (auto it = chainTable[idx].begin(); it != chainTable[idx].end(); ++it) {
                if (it->username == username) {
                    chainTable[idx].erase(it);
                    elementCount--;
                    return true;
                }
            }
        } else {
            for (size_t i = 0; i < capacity; ++i) {
                size_t idx = 0;
                if (strategy == LINEAR_PROBING) {
                    idx = (hashVal + i) % capacity;
                } else if (strategy == QUADRATIC_PROBING) {
                    idx = (hashVal + i * i) % capacity;
                } else if (strategy == DOUBLE_HASHING) {
                    idx = (hashVal + i * secondHash(hashVal)) % capacity;
                }

                if (openTable[idx].state == EMPTY) {
                    return false;
                }
                if (openTable[idx].state == OCCUPIED && openTable[idx].record.username == username) {
                    openTable[idx].state = DELETED;
                    elementCount--;
                    return true;
                }
            }
        }
        return false;
    }

    bool login(const string& username, const string& password) {
        UserRecord* rec = find(username);
        if (!rec) {
            cout << "LOGIN FAILED: User '" << username << "' not found.\n";
            return false;
        }

        uint64_t submittedHash = computePasswordHash(rec->salt, password);
        if (submittedHash == rec->passwordHash) {
            cout << "LOGIN SUCCESS: User '" << username << "' successfully authenticated!\n";
            return true;
        } else {
            cout << "LOGIN FAILED: Incorrect password for user '" << username << "'.\n";
            return false;
        }
    }
};

int main() {
    cout << "========================================================\n";
    cout << "     CUSTOM HASH TABLE & AUTHENTICATION DEMO           \n";
    cout << "========================================================\n";

    HashTable authSystem(4, CHAINING);

    cout << "\n--- Step 1: Registering 5 Initial Users ---";
    authSystem.insert("alice", "AlicePass123");
    authSystem.insert("bob", "SecureBob!!)");
    authSystem.insert("charlie", "Charlie789#");
    authSystem.insert("david", "DavidP@ssword");
    authSystem.insert("eve", "EveSecret456");

    cout << "Current Load Factor: " << authSystem.loadFactor() << "\n";

    cout << "\n--- Step 2: Testing Login Flow Operations ---";
    cout << "\n1. Demonstrating Successful Login:\n   ";
    authSystem.login("alice", "AlicePass123");

    cout << "\n2. Demonstrating Failed Login (Wrong Password):\n   ";
    authSystem.login("alice", "WrongPassword!");

    cout << "\n3. Demonstrating Failed Login (Unknown User):\n   ";
    authSystem.login("malory", "AnyPassword");

    cout << "\n--- Step 3: Demonstrating User Removal ---";
    cout << "\nAttempting to remove user 'charlie'...\n";
    if (authSystem.remove("charlie")) {
        cout << "User 'charlie' successfully removed.\n";
    }

    cout << "\nVerifying removal by logging in as 'charlie':\n   ";
    authSystem.login("charlie", "Charlie789#");

    cout << "\nVerifying lookup for removed user 'charlie':\n   ";
    if (authSystem.find("charlie") == nullptr) {
        cout << "find(\"charlie\") returned nullptr (Not found).\n";
    }

    return 0;
}
